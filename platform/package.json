{
  "name": "profectium",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "build:beget": "node node_modules/next/dist/bin/next build --webpack",
    "start:beget": "node server.cjs",
    "test:sqlite": "node tests/sqlite-runtime.mjs",
    "test:auth": "node tests/public-auth.mjs",
    "cloudflare:prepare": "node scripts/cloudflare.mjs prepare",
    "cloudflare:check": "node scripts/cloudflare.mjs check",
    "cloudflare:preview": "node scripts/cloudflare.mjs preview",
    "cloudflare:migrate": "node scripts/cloudflare.mjs migrate",
    "cloudflare:deploy": "node scripts/cloudflare.mjs deploy",
    "start": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node tests/run.mjs && node tests/concurrency.mjs && node tests/v3-security.mjs && node tests/feature-invariants.mjs && node tests/v4-security.mjs && node tests/v5-security.mjs && node tests/offline-runner.mjs && node tests/qualification-regression.mjs && node tests/brief-matching-regression.mjs && node tests/employer-tests.mjs && node tests/employer-test-ui.mjs && node tests/offline-launcher-integration.mjs && node tests/query-parser.mjs && node tests/offer-decline-reason.mjs && node tests/search-assistant.mjs && node tests/local-session.mjs",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/migrate-local.mjs",
    "api:docs": "node scripts/generate-openapi.mjs",
    "evaluate": "node tests/evaluate.mjs",
    "pdf:sample": "node scripts/export-demo-profile.mjs",
    "offline": "node scripts/start-offline.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "author": "Криницин Вячеслав Александрович (Oladievic)"
}
